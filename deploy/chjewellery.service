[Unit]
Description=CH Jewels — chjewellery (Next.js showroom)
After=network.target postgresql.service

[Service]
Type=simple
User=chjewellery
WorkingDirectory=/var/www/chjewellery
EnvironmentFile=/var/www/chjewellery/.env.local
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/chjewellery/storage

[Install]
WantedBy=multi-user.target
